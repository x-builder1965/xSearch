{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug Electron: Main",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      // preLaunchTaskとして文字コード変更を挟むか、またはコマンドライン経由で起動
      "runtimeExecutable": "cmd.exe",
      "windows": {
        "runtimeExecutable": "cmd.exe"
      },
      "args": [
        "/c",
        "chcp 65001 >nul && \"${workspaceFolder}\\node_modules\\.bin\\electron.cmd\" . --remote-debugging-port=9223"
      ],
      "console": "integratedTerminal",
      "outputCapture": "std",
      "timeout": 30000
    },
    {
      "name": "Debug Electron: Renderer",
      "type": "chrome",
      "request": "attach",
      "port": 9223,
      "webRoot": "${workspaceFolder}",
      "timeout": 60000,
      "sourceMaps": true,
      "trace": true
    }
  ],
  "compounds": [
    {
      "name": "Debug Electron: All",
      "configurations": [
        "Debug Electron: Main",
        "Debug Electron: Renderer"
      ]
    }
  ]
}
